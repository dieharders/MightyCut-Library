{
  "name": "mightycut-library",
  "version": "0.7.21",
  "description": "MightyCut shared component library — the single source of truth for components, treatments, themes, FX, and Zod contracts. Consumed by the MotionBuff desktop app.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components/*": {
      "bun": "./src/components/*.ts",
      "types": "./src/components/*.ts",
      "import": "./src/components/*.ts"
    },
    "./types/*": {
      "bun": "./src/types/*.ts",
      "types": "./src/types/*.ts",
      "import": "./src/types/*.ts"
    },
    "./pipeline/*": {
      "bun": "./src/pipeline/*.ts",
      "types": "./src/pipeline/*.ts",
      "import": "./src/pipeline/*.ts"
    },
    "./util/*": {
      "bun": "./src/util/*.ts",
      "types": "./src/util/*.ts",
      "import": "./src/util/*.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/types/engine/index.d.ts"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "gen:fonts": "node scripts/gen-inline-fonts.mjs",
    "lint": "eslint .",
    "pretypecheck": "bun run gen:fonts",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run gen:fonts",
    "test": "bun test",
    "prebuild:engine": "bun run gen:fonts",
    "build:engine": "vite build && tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.2.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^5.0.3"
  }
}
